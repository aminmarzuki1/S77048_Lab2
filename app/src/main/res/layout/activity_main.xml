<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/box_border"
        android:gravity="center"
        android:text="[ Penganalisis Peribadi ]"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_margin="10dp"
        android:text="Nama Penuh:"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/box_border"
        android:hint="cth: Ahmad bin Ali"
        android:layout_margin="10dp"
        android:inputType="textPersonName"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_margin="10dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Tarikh Lahir:"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editTarikh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/box_border"
        android:hint="2000-05-15"
        android:layout_margin="15dp"
        android:inputType="date"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnAnalisis"
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ANALISIS SAYA" />

</LinearLayout>